{
  "name": "corgi-editor",
  "version": "0.2.1",
  "description": "CORGI-EDITOR - Edição automática de vídeo/áudio",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --win",
    "preview": "vite preview"
  },
  "author": "Luiz",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0"
  },
  "build": {
    "appId": "com.corgi.editor",
    "productName": "CORGI-EDITOR",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/logo.ico",
      "signExecutable": false
    }
  }
}
