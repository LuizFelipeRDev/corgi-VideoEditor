{
  "name": "corgi-editor",
  "version": "1.0.0",
  "description": "CORGI-EDITOR - Edição automática de vídeo/áudio",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --win",
    "preview": "vite preview"
  },
  "author": "Luiz",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "wavesurfer.js": "^7.12.12"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0"
  },
  "build": {
    "appId": "com.corgi.editor",
    "productName": "CORGI-EDITOR",
    "files": [
      "dist/**/*",
      "!dist/win-unpacked/**",
      "!dist/*.7z",
      "!dist/builder-*"
    ],
    "extraResources": [
      {
        "from": "bin/auto-editor.exe",
        "to": "bin/auto-editor.exe"
      },
      {
        "from": "bin/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "bin/ffplay.exe",
        "to": "bin/ffplay.exe"
      },
      {
        "from": "bin/ffprobe.exe",
        "to": "bin/ffprobe.exe"
      },
      {
        "from": "bin/whisper/ggml-tiny.bin",
        "to": "bin/whisper/ggml-tiny.bin"
      },
      {
        "from": "src/global_config/fonts/",
        "to": "fonts/"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/logo.ico",
      "signExecutable": false
    }
  }
}
